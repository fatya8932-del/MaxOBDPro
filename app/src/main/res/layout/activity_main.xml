<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1E1E1E"
        android:padding="12dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@t+/id/tvStatus"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Disconnected: KONNWEI"            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+/id/tvVoltage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--.- V"
            android:textColor="#00E676"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginEnd="16dp" />
        <Button
            android:id="@+/id/btnConnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connect KONNWEI"            android:backgroundTint="#FF6D00"
            android:textColor="#FFFFFF" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical">
        <Spinner
            android:id="@+/id/spinnerBrand"
            android:layout_width="0px"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="#2C2C2C" />
        <TextView
            android:id="@t+/id/tvAdapterAlert"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:layout_marginStart="12dp"
            android:padding="10dp"
            android:background="#1B5E20"
            android:text="Direct Plug: KONNWEI MAXOBD Ready"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">
        <Button
            android:id="@+/id/btnReadDtc"
            android:layout_width="0px"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Read DTC"
            android:backgroundTint="#1976D2"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="6dp" />
        <Button
            android:id="@t+/id/btnClearDtc"
            android:layout_width="0px"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Clear DTC"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="6dp" />
        <Button
            android:id="@+/id/btnLiveData"
            android:layout_width="0px"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Live Data"
            android:backgroundTint="#00796B"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="6dp" />
        <Button
            android:id="@+/id/btnActiveTest"
            android:layout_width="0px"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Injector #1 Cut"
            android:backgroundTint="#F57C00"
            android:textColor="#FFFFFF" />
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:background="#1A1A1A"
        android:padding="16dp">
        <TextView
            android:id="@t+/id/tvConsole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready... Press Connect KONNWEI"
            android:textColor="#00E676"
            android:textSize="18sp" />
    </ScrollView>
</LinearLayout>
